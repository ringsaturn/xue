    "impact_en": "Moderate",
    "impact_fr": "modéré",
    "feature_name_en": "Kluane Lake",
    "feature_name_fr": "lac Klouane",
    "province": "YT",
    "status_en": "issued",
    "status_fr": "émis",
    "feature_id": "fea1-2437"
