# Cloudflare Pages deploy builds (`make deploy-build`, i.e. `vite build --mode
# deploy`) download forecast bundles straight from the public R2 bucket
# (dataset.ringsaturn.me) instead of the site origin, because bundles exceed
# the Cloudflare Pages 25 MB per-file limit. Regular `npm run build` and dev
# builds leave this unset and read from the local data/ directory.
VITE_DATA_BASE_URL=https://dataset.ringsaturn.me/xue/
