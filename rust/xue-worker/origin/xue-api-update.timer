# Check the api-server release every five minutes. A run that finds the
# installed binary current downloads only the 100-byte .sha256.
[Unit]
Description=Check the api-server release for a new xue-api-server

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
